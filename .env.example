# このファイルを .env にコピーして、実際の値を入れてください（.env はGitにコミットしないこと）
# Renderなど本番環境にデプロイする場合は、.envファイルではなく
# ダッシュボードの「Environment Variables」欄にこれらを直接登録します。

# LINE Developers Console > チャネル基本設定 > Channel secret
LINE_CHANNEL_SECRET=

# LINE Developers Console > Messaging API設定 > チャネルアクセストークン
LINE_CHANNEL_ACCESS_TOKEN=

# OpenAI (platform.openai.com) で発行したAPIキー
OPENAI_API_KEY=

# 使用するモデル（画像を扱うのでVision対応モデル、かつWeb検索ツールに対応した
# モデルを指定してください。例: gpt-5.6 / gpt-5.5 / gpt-4.1 系）
OPENAI_MODEL=gpt-5.6

# （任意）Web検索機能。falseにすると、検索なしの普通の会話だけになります
# （コストを抑えたい場合や、OPENAI_MODELが検索非対応の場合はfalseに）
OPENAI_WEB_SEARCH=true

# （任意）メンバーごとのキャラクター学習機能を使う場合のみ設定
# Supabase プロジェクトの Settings > API から取得
# SUPABASE_URL: Project URL
# SUPABASE_SERVICE_KEY: service_role キー（anon keyではなく、こちらを使います）
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

PORT=3000
