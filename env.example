# このファイルを .env にコピーして、実際の値を入れてください（.env はGitにコミットしないこと）
# Renderなど本番環境にデプロイする場合は、.envファイルではなく
# ダッシュボードの「Environment Variables」欄にこれらを直接登録します。

# LINE Developers Console > チャネル基本設定 > Channel secret
LINE_CHANNEL_SECRET=

# LINE Developers Console > Messaging API設定 > チャネルアクセストークン
LINE_CHANNEL_ACCESS_TOKEN=

# OpenAI (platform.openai.com) で発行したAPIキー
OPENAI_API_KEY=

# 使用するモデル（画像を扱うのでVision対応モデルを指定してください）
OPENAI_MODEL=gpt-5

PORT=3000
